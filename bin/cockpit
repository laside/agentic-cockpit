#!/usr/bin/env bash
set -euo pipefail
COCKPIT_HOME="${COCKPIT_HOME:-$HOME/agentic-cockpit}"
DB_PATH="$COCKPIT_HOME/db/cockpit_pmo.db"
CMD="${1:-open}"
shift || true

usage() {
  echo "Usage: cockpit {open|switch|new-project|secret|costs|judge-calibrate|roadmap|ticket|plan|run|auto|claim|submit|release|sync|status|brief|note|lessons|abandon|dispatch|merge|events|relaunch|privacy-check|install-hooks|ui|help}"
}

# Projet par défaut : default_project du premier projects.toml trouvé (même ordre que cockpit-env.sh).
default_project() {
  local toml="" candidat
  for candidat in "${PROJECTS_TOML:-}" \
      "${COCKPIT_CONFIG_DIR:-$HOME/.config/agentic-cockpit}/projects.toml" \
      "$COCKPIT_HOME/config/projects.toml" \
      "$COCKPIT_HOME/config/projects.example.toml"; do
    if [ -n "$candidat" ] && [ -f "$candidat" ]; then
      toml="$candidat"
      break
    fi
  done
  if [ -z "$toml" ]; then
    echo "cockpit"
    return
  fi
  python3 -c 'import sys, tomllib; print(tomllib.load(open(sys.argv[1], "rb")).get("default_project") or "cockpit")' "$toml" 2>/dev/null || echo "cockpit"
}

case "$CMD" in
  help|-h|--help)
    usage
    exit 0
    ;;
  open|switch)
    PROJ="${1:-${PROJECT:-cockpit}}"
    export PROJECT="$PROJ"
    source "$COCKPIT_HOME/scripts/cockpit-env.sh"
    SESSION="cockpit-$PROJECT"
    LAYOUT_DIR="$HOME/.cache/agentic-cockpit/layouts"
    mkdir -p "$LAYOUT_DIR"
    LAYOUT_FILE="$LAYOUT_DIR/$SESSION.kdl"
    sed -e "s|__PROJECT_ID__|$PROJECT|g" \
        -e "s|__PROJECT_NAME__|$PROJECT_NAME|g" \
        -e "s|__PROJECT_ROOT__|$PROJECT_ROOT|g" \
        -e "s|__WT_SESSIONS_DIR__|$WT_SESSIONS_DIR|g" \
        -e "s|__SIDECAR_PORT__|$SIDECAR_PORT|g" \
        -e "s|__COCKPIT_HOME__|$COCKPIT_HOME|g" \
        "$COCKPIT_HOME/layouts/cockpit.kdl.tmpl" > "$LAYOUT_FILE"
    if [ -n "${ZELLIJ:-}" ]; then
      # Déjà dans Zellij : jamais de session imbriquée, on bascule de session (les autres restent ouvertes).
      if ! zellij action switch-session --help >/dev/null 2>&1; then
        echo "Cette version de Zellij ne permet pas « zellij action switch-session » : mettez Zellij à jour, ou quittez la session (Ctrl+o d) puis lancez « cockpit switch $PROJECT »." >&2
        exit 1
      fi
      if ! zellij list-sessions --no-formatting 2>/dev/null | grep -q "^$SESSION\b"; then
        zellij attach --create-background "$SESSION" options --default-layout "$LAYOUT_FILE" >/dev/null
      fi
      exec zellij action switch-session "$SESSION"
    fi
    if zellij list-sessions --no-formatting 2>/dev/null | grep -q "^$SESSION\b"; then
      exec zellij attach "$SESSION"
    else
      exec zellij --session "$SESSION" --new-session-with-layout "$LAYOUT_FILE"
    fi
    ;;
  new-project)
    bash "$COCKPIT_HOME/scripts/new-project.sh" "$@"
    ;;
  secret)
    KEY="${1:-}"
    [ -n "$KEY" ] || { echo "Usage: cockpit secret MISTRAL_API_KEY" >&2; exit 1; }
    [[ "$KEY" =~ ^[A-Z][A-Z0-9_]*$ ]] || { echo "Clé secrète invalide : $KEY (attendu: ^[A-Z][A-Z0-9_]*$)" >&2; exit 1; }
    ENV_FILE="$COCKPIT_HOME/.env.cockpit"
    touch "$ENV_FILE" && chmod 600 "$ENV_FILE"
    read -r -s -p "Valeur secrète pour $KEY : " VAL
    echo ""
    grep -v "^${KEY}=" "$ENV_FILE" > "${ENV_FILE}.tmp" || true
    printf '%s=%q\n' "$KEY" "$VAL" >> "${ENV_FILE}.tmp"
    mv "${ENV_FILE}.tmp" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
    if [ "$KEY" = "MISTRAL_API_KEY" ]; then
      COCKPIT_HOME="$COCKPIT_HOME" DB_PATH="$DB_PATH" python3 - << 'PY'
import os
import sys
from pathlib import Path
sys.path.insert(0, os.path.join(os.environ["COCKPIT_HOME"], "core"))
from pmo_db import CockpitDB

CockpitDB(Path(os.environ["DB_PATH"])).set_mistral_key_active(True)
PY
      echo "OK : Clé MISTRAL_API_KEY enregistrée et voie Mistral Vibe (abonnement forfaitaire) ACTIVÉE dans le Gouverneur."
    else
      echo "OK : Secret $KEY mis à jour dans $ENV_FILE (0600)."
    fi
    ;;
  dispatch)
    bash "$COCKPIT_HOME/scripts/dispatch-ticket.sh" "$@"
    ;;
  relaunch)
    exec bash "$COCKPIT_HOME/scripts/relaunch.sh" "$@"
    ;;
  run|merge|ticket|plan|events|auto|claim|submit|release|sync|status|brief|note|abandon)
    exec python3 "$COCKPIT_HOME/core/pipeline.py" "$CMD" "$@"
    ;;
  costs)
    exec python3 "$COCKPIT_HOME/core/costs_report.py" "$@"
    ;;
  judge-calibrate)
    exec python3 "$COCKPIT_HOME/core/judge_calibrate.py" "$@"
    ;;
  lessons)
    exec python3 "$COCKPIT_HOME/core/lessons.py" "$@"
    ;;
  roadmap)
    PROJ="${1:-${PROJECT:-cockpit}}"
    python3 "$COCKPIT_HOME/tui/pmo_dashboard.py" --project "$PROJ" --db "$DB_PATH" --once
    ;;
  privacy-check)
    exec python3 "$COCKPIT_HOME/scripts/privacy-check.py" "$@"
    ;;
  install-hooks)
    exec bash "$COCKPIT_HOME/scripts/install-hooks.sh" "$@"
    ;;
  ui)
    PROJ="${1:-$(default_project)}"
    VENV="${TUI_VENV:-$HOME/.local/share/agentic-cockpit/tui-venv}"
    if [ ! -x "$VENV/bin/python" ]; then
      echo "Environnement de l'écran absent : création de $VENV via scripts/tui-setup.sh…" >&2
      bash "$COCKPIT_HOME/scripts/tui-setup.sh"
    fi
    export COCKPIT_HOME
    export PATH="$COCKPIT_HOME/bin:$PATH"
    cd "$COCKPIT_HOME"
    exec "$VENV/bin/python" -m tui.commande.app "$PROJ"
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
